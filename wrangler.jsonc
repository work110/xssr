{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-winds-meet-x",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "1261bc7bf6674ccc865eea8999fe4c67"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "7,37 * * * *"
    ]
  }
}
